#!/usr/bin/env sh
set -eu
MAVEN_VERSION="3.9.11"
CACHE_ROOT="${MAVEN_USER_HOME:-${HOME}/.m2}/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_HOME="${CACHE_ROOT}/apache-maven-${MAVEN_VERSION}"
if [ ! -x "${MAVEN_HOME}/bin/mvn" ]; then
  mkdir -p "${CACHE_ROOT}"
  ARCHIVE="${CACHE_ROOT}/maven.tar.gz"
  URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
  echo "Maven ${MAVEN_VERSION} is not cached. Downloading it from Apache..."
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 3 "${URL}" -o "${ARCHIVE}"
  elif command -v wget >/dev/null 2>&1; then wget -O "${ARCHIVE}" "${URL}"
  else echo "Install curl or wget to bootstrap Maven." >&2; exit 1
  fi
  tar -xzf "${ARCHIVE}" -C "${CACHE_ROOT}"
  rm -f "${ARCHIVE}"
fi
exec "${MAVEN_HOME}/bin/mvn" "$@"
